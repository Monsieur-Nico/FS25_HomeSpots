<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Home Spots page of the in-game menu: one row per vehicle or tool with a home spot -->
<GUI name="homeSpotsOverview">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="homeSpotsHeaderIcon" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="homeSpotsHeaderText" />
        </GuiElement>

        <GuiElement profile="fs25_subCategorySelectorTabbedContainer">
            <!-- Table header as on the game's own list pages; each title uses the same position, width and text offset as its column in the rows -->
            <GuiElement profile="fs25_statisticsHeaderBox">
                <Text profile="homeSpots_columnTitle" id="homeSpotsColumnVehicle" position="0px 0px" width="380px" />
                <Text profile="homeSpots_columnTitle" id="homeSpotsColumnStatus" position="384px 0px" width="200px" />
                <Text profile="homeSpots_columnTitle" id="homeSpotsColumnDistance" position="594px 0px" width="220px" />
                <!-- How many are away, in use and home, centred above the picture panel -->
                <Text profile="homeSpots_summary" id="homeSpotsSummary" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp" />
            </GuiElement>

            <SmoothList profile="homeSpots_list" id="homeSpotsList" focusChangeTop="nil" focusChangeBottom="nil" selectedWithoutFocus="true">
                <ListItem profile="homeSpots_listItem">
                    <!-- Fixed columns, narrow enough for the list on a 4:3 screen; the column titles above use the same positions -->
                    <Text profile="homeSpots_listItemText" name="name" position="0px 0px" width="380px" />
                    <Text profile="homeSpots_listItemText" name="status" position="384px 0px" width="200px" />
                    <Text profile="homeSpots_listItemText" name="distance" position="594px 0px" width="220px" />
                </ListItem>
            </SmoothList>

            <ThreePartBitmap profile="homeSpots_listSliderBox">
                <Slider profile="fs25_listSlider" dataElementId="homeSpotsList" />
            </ThreePartBitmap>

            <Text profile="fs25_aiContainerEmptyText" id="homeSpotsEmptyText" position="0px -120px" />

            <!-- Shop picture of the selected vehicle or tool -->
            <GuiElement profile="homeSpots_preview" id="homeSpotsPreview">
                <Bitmap profile="homeSpots_previewBackground" />
                <Bitmap profile="homeSpots_previewImage" id="homeSpotsPreviewImage" />
                <Text profile="homeSpots_previewName" id="homeSpotsPreviewName" />
                <Text profile="homeSpots_previewText" id="homeSpotsPreviewStatus" position="0px -470px" />
                <Text profile="homeSpots_previewText" id="homeSpotsPreviewDistance" position="0px -506px" />
                <Text profile="homeSpots_previewTools" id="homeSpotsPreviewTools" />
            </GuiElement>
        </GuiElement>
    </GuiElement>

    <GUIProfiles>
        <Profile name="homeSpots_list" extends="emptyPanel" with="anchorStretchingYStretchingX pivotTopLeft">
            <position value="0px -56px" />
            <absoluteSizeOffset value="460px 56px" />
        </Profile>
        <Profile name="homeSpots_listItem" extends="baseReference" with="anchorTopStretchingX alternating">
            <height value="48px" />
            <imageColor value="$preset_fs25_colorGrey" />
            <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
            <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50" />
        </Profile>
        <Profile name="homeSpots_listItemText" extends="fs25_textDarkHighlight" with="anchorStretchingYLeft">
            <textBold value="true" />
            <textOffset value="16px 0px" />
            <textSize value="20px" />
            <textMaxNumLines value="1" />
        </Profile>
        <!-- The game's header title, with the row text's offset and alignment so titles start where values start -->
        <Profile name="homeSpots_columnTitle" extends="fs25_statisticsHeaderText">
            <textOffset value="16px 0px" />
            <textAlignment value="left" />
            <textMaxNumLines value="1" />
        </Profile>
        <Profile name="homeSpots_summary" extends="homeSpots_columnTitle" with="anchorStretchingYRight">
            <position value="0px 0px" />
            <width value="400px" />
            <textOffset value="0px 0px" />
            <textAlignment value="center" />
        </Profile>
        <Profile name="homeSpots_listSliderBox" extends="fs25_listSliderBox" with="anchorTopRight">
            <position value="-420px -56px" />
            <absoluteSizeOffset value="0px 56px" />
        </Profile>
        <Profile name="homeSpots_preview" extends="emptyPanel" with="anchorTopRight">
            <position value="0px -56px" />
            <size value="400px 620px" />
        </Profile>
        <Profile name="homeSpots_previewBackground" extends="baseReference" with="anchorStretchingYStretchingX">
            <imageColor value="$preset_fs25_colorGreyDark_50" />
        </Profile>
        <Profile name="homeSpots_previewImage" extends="baseReference" with="anchorTopCenter">
            <position value="0px -20px" />
            <size value="360px 360px" />
            <imageColor value="1 1 1 1" />
        </Profile>
        <Profile name="homeSpots_previewName" extends="fs25_textDefault" with="anchorTopStretchingX">
            <position value="0px -400px" />
            <height value="60px" />
            <textBold value="true" />
            <textSize value="22px" />
            <textAlignment value="center" />
            <textMaxNumLines value="2" />
            <textOffset value="0px 0px" />
        </Profile>
        <Profile name="homeSpots_previewText" extends="fs25_textDefault" with="anchorTopStretchingX">
            <height value="30px" />
            <textSize value="20px" />
            <textAlignment value="center" />
            <textMaxNumLines value="1" />
        </Profile>
        <Profile name="homeSpots_previewTools" extends="homeSpots_previewText">
            <position value="20px -546px" />
            <height value="54px" />
            <absoluteSizeOffset value="40px 0px" />
            <textSize value="18px" />
            <textMaxNumLines value="2" />
        </Profile>
    </GUIProfiles>
</GUI>
