    "InputAction",
    "Logging",
    "MapHotspot",
    "MathUtil",
    "MessageType",
    "MoneyType",
    "MultiTextOptionElement",
    "NetworkUtil",
    "Overlay",
    "TabbedMenuFrameElement",
    "TextElement",
    "Utils",
    "YesNoDialog",
    "addModEventListener",
    "createTransformGroup",
    "createXMLFile",
    "delete",
    "entityExists",
    "fileExists",
    "g_client",
    "g_currentMission",
    "g_currentModDirectory",
    "g_currentModName",
    "g_farmManager",
    "g_gui",
    "g_i18n",
    "g_inputBinding",
    "g_localPlayer",
    "g_messageCenter",
    "g_server",
    "getNormalizedScreenValues",
    "getHasClassId",
    "getHasTrigger",
    "getName",
    "getParent",
    "getTerrainHeightAtWorldPos",
    "g_terrainNode",
    "link",
    "overlapBox",
    "raycastClosest",
    "getWorldRotation",
    "getWorldTranslation",
    "getXMLInt",
    "getXMLString",
    "hasXMLProperty",
    "loadXMLFile",
    "localDirectionToWorld",
    "raycastAll",
    "saveXMLFile",
    "setRotation",
    "setTranslation",
    "setWorldRotation",
    "setWorldTranslation",
    "setXMLInt",
