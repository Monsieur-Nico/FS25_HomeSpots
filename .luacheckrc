-- The tests replace the game with stand-ins, so they may define any global
files["tests/"] = {
    allow_defined_top = true,
    globals = {"lookRay"},
    read_globals = {},
    ignore = {"111", "112", "113", "121", "122", "131", "142", "143"},
}
